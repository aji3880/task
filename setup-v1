oc expose service qed -n math 2>/dev/null || true
cat <<EOF | oc apply -n math -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: qed
  namespace: math
  labels:
    app: qed
spec:
  replicas: 1
  selector:
    matchLabels:
      app: qed
  template:
    metadata:
      labels:
        app: qed
    spec:
      containers:
      - name: qed
        image: registry.redhat.io/rhscl/nginx-116-rhel7
        ports:
        - containerPort: 8080
          protocol: TCP
        command: ["/bin/sh", "-c"]
        args:
        - |
          # 1. Pengecekan Fail-Fast (JIKA SECRET/ENV BELUM TERPASANG)
          if [ -z "\$DECODER_RING" ]; then
            echo "Sorry, application is not configured correctly."
            echo "FATAL: DECODER_RING environment variable is missing!"
            exit 1
          fi

          # 2. Generate HTML ke Lokasi Web Root Nginx yang Benar
          mkdir -p /usr/share/nginx/html /opt/app-root/src
          
          cat <<HTML | tee /usr/share/nginx/html/index.html /opt/app-root/src/index.html
          <!DOCTYPE html>
          <html>
          <head>
            <title>QED Application Decoded</title>
            <style>
              body { font-family: monospace, Arial; background-color: #0d1117; color: #ffffff; text-align: center; padding-top: 50px; }
              .box { border: 3px solid #2ea043; background-color: #161b22; display: inline-block; padding: 30px; border-radius: 10px; max-width: 600px; }
              .success { color: #3fb950; font-size: 22px; font-weight: bold; margin-bottom: 20px; }
              .code { background-color: #0d1117; color: #58a6ff; padding: 12px; font-size: 15px; border-radius: 5px; word-break: break-all; border: 1px solid #30363d; }
            </style>
          </head>
          <body>
            <div class="box">
              <div class="success">[ OK ] QED APPLICATION IS FULLY DECODED!</div>
              <p>Environment Variable <b>DECODER_RING</b> Loaded:</p>
              <div class="code">\$DECODER_RING</div>
            </div>
          </body>
          </html>
          HTML

          exec nginx -g "daemon off;"
EOF

