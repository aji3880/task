oc new-project alpha
oc new-app --name gitlab  --image docker.io/gitlab/gitlab-ce:latest

oc new-project quart
oc new-app --name todo-http --image image-registry.openshift-image-registry.svc:5000/openshift/httpd 
oc expose service todo-http --hostname  todo-http$(oc whoami --show-console | sed -n 's/.*\(\.apps\..*\)/\1/p')

oc new-project red
oc new-app --name red-app --image image-registry.openshift-image-registry.svc:5000/openshift/httpd
oc patch deployment red-app   -p '{"spec":{"template":{"spec":{"containers":[{"name":"red-app","resources":{"limits":{"cpu":"20","memory":"40Gi"}}}]}}}}'
TARGET_NODE=$(oc get nodes -l node-role.kubernetes.io/worker -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
if [ -z "$TARGET_NODE" ]; then
  TARGET_NODE=$(oc get nodes -o jsonpath='{.items[0].metadata.name}')
fi
oc adm taint node $TARGET_NODE datacenter=delhi:NoSchedule --overwrite
oc patch deployment red-app -p '{"spec":{"template":{"spec":{"nodeSelector":{"kubernetes.io/hostname":"'"$TARGET_NODE"'"}}}}}'

oc new-project cloud
oc create deployment mysql-app --image image-registry.openshift-image-registry.svc:5000/openshift/mysql
oc create secret generic ex280-root --from-literal=MYSQL_USER=redhat --from-literal=MYSQL_DATABASE=world_x
oc set env --from=secret/ex280-root deployment mysql-app

oc new-project tiger
oc new-app --name hello --image image-registry.openshift-image-registry.svc:5000/openshift/httpd

oc new-project scalling
oc new-app --name hello --image image-registry.openshift-image-registry.svc:5000/openshift/httpd

oc new-project network-policy 2>/dev/null || oc project network-policy
oc delete deployment hello -n network-policy 2>/dev/null || true
oc delete route hello -n network-policy 2>/dev/null || true

cat <<TARGET | oc apply -n network-policy -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello
  namespace: network-policy
  labels:
    app: hello
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hello
  template:
    metadata:
      labels:
        app: hello
        env: production
    spec:
      containers:
      - name: hello
        image: registry.redhat.io/rhscl/httpd-24-rhel7
        ports:
        - containerPort: 8080
TARGET
oc expose deployment hello --port=8080 -n network-policy 2>/dev/null || true
oc expose service hello -n network-policy 2>/dev/null || true
ROUTE_HOST=$(oc get route hello -n network-policy -o jsonpath='{.spec.host}')
cat <<DENY | oc apply -n network-policy -f -
kind: NetworkPolicy
apiVersion: networking.k8s.io/v1
metadata:
  name: default-deny-ingress
  namespace: network-policy
spec:
  podSelector: {}
  policyTypes:
  - Ingress
DENY

oc new-project different-namespace 2>/dev/null || oc project different-namespace
cat <<CLIENT | oc apply -n different-namespace -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: client-app
  namespace: different-namespace
spec:
  replicas: 1
  selector:
    matchLabels:
      app: client-app
  template:
    metadata:
      labels:
        app: client-app
    spec:
      containers:
      - name: client
        image: registry.redhat.io/ubi8/ubi-minimal
        command: ["/bin/sh", "-c"]
        args:
        - |
          TARGET="http://${ROUTE_HOST}"
          while true; do
            if curl -s -m 2 \${TARGET} > /dev/null; then
              echo "\$(date '+%H:%M:%S') [SUCCESS] Connected to \${TARGET}"
            else
              echo "\$(date '+%H:%M:%S') [FAILED] Connection blocked by NetworkPolicy."
            fi
            sleep 3
          done
CLIENT
echo "=== Setup Lab Selesai! Route Target: http://${ROUTE_HOST} ==="
EOF

oc new-project tuesday
oc new-app --name liveness-deployment --image image-registry.openshift-image-registry.svc:5000/openshift/httpd
